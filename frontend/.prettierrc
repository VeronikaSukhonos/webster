{
  "bracketSpacing": true,
  "endOfLine": "auto",
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "react",
    "<THIRD_PARTY_MODULES>",
    "^@api/(.*)$",
    "^@store/(.*)$",
    "^@contexts/(.*)$",
    "^@pages/(.*)$",
    "^@components/(.*)$",
    "^@assets/(.*)$",
    "^@hooks/(.*)$",
    "^@utils/(.*)$",
    "^@mytypes/(.*)$",
    "^[./](?!.*\\.css$)",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
